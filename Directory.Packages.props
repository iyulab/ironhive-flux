<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="IronHive">
    <PackageVersion Include="IronHive.Abstractions" Version="0.22.1" />
    <PackageVersion Include="IronHive.Core" Version="0.22.1" />
    <PackageVersion Include="IronHive.Plugins.MCP" Version="0.22.1" />
    <PackageVersion Include="IronHive.Providers.OpenAI" Version="0.22.1" />
  </ItemGroup>
  <ItemGroup Label="Flux Ecosystem">
    <PackageVersion Include="FileFlux" Version="0.22.2" />
    <PackageVersion Include="FileFlux.Core" Version="0.22.2" />
    <PackageVersion Include="WebFlux" Version="0.7.0" />
    <PackageVersion Include="WebLookup" Version="0.2.1" />
    <PackageVersion Include="FluxIndex.Core" Version="0.28.4" />
    <PackageVersion Include="FluxFeed" Version="0.18.2" />
    <PackageVersion Include="FluxIndex.SDK" Version="0.28.4" />
    <PackageVersion Include="TokenMeter" Version="0.7.3" />
  </ItemGroup>
  <ItemGroup Label="Microsoft">
    <!-- Override transitive vulnerable dependency (GHSA-73j8-2gch-69rq) -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.6.5" />
    <PackageVersion Include="Polly.Extensions" Version="8.6.5" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <!-- xUnit v3/MTP native mode: no Microsoft.NET.Test.Sdk needed, coverlet.collector was a dead
         reference (CI never invoked the coverage collector flag) -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
  </ItemGroup>
</Project>